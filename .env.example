# Copia este fichero a .env y ajusta los valores (el .env NO se versiona).

# --- Conexión del pipeline ETL (propietario del modelo) ---
DW_HOST=localhost
DW_PORT=5432
DW_DATABASE=analytics_dw
DW_USER=etl_user
DW_PASSWORD=cambia_esta_clave_etl
# disable | allow | prefer | require | verify-ca | verify-full
DW_SSLMODE=prefer

# --- Contraseña del rol de solo lectura "bi_reader" (Power BI / Looker Studio) ---
BI_READER_PASSWORD=cambia_esta_clave_bi

# --- Superusuario (solo para setup_database.py, una única vez) ---
PG_ADMIN_USER=postgres
PG_ADMIN_PASSWORD=
# En Linux se puede usar el socket local con autenticación peer: PG_ADMIN_HOST=/var/run/postgresql
PG_ADMIN_HOST=localhost
PG_ADMIN_PORT=5432
