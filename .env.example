# Todas las variables son opcionales: los valores por defecto funcionan con
# docker-compose.yml. Docker Compose lee `.env` automáticamente; para los
# scripts de Python, expórtalas en la shell (p. ej. `set -a; . ./.env; set +a`).

# PostgreSQL (docker-compose.yml y config.py)
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=etl_password
POSTGRES_DB=finanzas
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Alternativa: DSN completo (tiene prioridad sobre las variables anteriores)
# DATABASE_URL=postgresql://etl_user:etl_password@127.0.0.1:5432/finanzas

# Imagen alternativa si Docker Hub limita las descargas (HTTP 429)
# POSTGRES_IMAGE=mirror.gcr.io/library/postgres:16

# Pool de conexiones de la API (por proceso worker de uvicorn)
DB_POOL_MAX=10
# DB_POOL_MIN=10  # por defecto igual a DB_POOL_MAX (pool pre-abierto)

# Locust
LOCUST_MAX_USUARIO_ID=10000
LOCUST_WAIT_MIN=0
LOCUST_WAIT_MAX=0
