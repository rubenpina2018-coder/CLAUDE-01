# Copy to .env (git-ignored) or define these as CI/CD secrets. Never commit real values.
# Load into your shell with:  set -a && source .env && set +a

# --- Azure ML workspace coordinates (mlops_pipeline.py --mode azure) -------------------
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=rg-fraud-mlops
AZUREML_WORKSPACE_NAME=mlw-fraud-detection

# --- Authentication (DefaultAzureCredential) -------------------------------------------
# Locally, prefer `az login` (nothing to set here). In CI prefer OIDC workload identity
# federation (azure/login@v2: AZURE_CLIENT_ID + AZURE_TENANT_ID, no secret).
# Service-principal secret: only as a last resort.
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_SECRET=

# --- Inference API (app/settings.py reads .env automatically) --------------------------
FRAUD_API_MODEL_PATH=outputs/model/model.gguf
FRAUD_API_LOG_LEVEL=INFO
FRAUD_API_DOCS_ENABLED=true
